# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Google Cloud Storage configuration
# Use one of the following authentication methods:

# Method 1: Service account key file (JSON) - recommended for local development
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Method 2: Service account key as base64 encoded string (useful for containers/CI)
# GOOGLE_APPLICATION_CREDENTIALS_BASE64=

# Method 3: Use Application Default Credentials (ADC) - for GCP environments

# GCS bucket name
GCS_BUCKET_NAME=your-bucket-name

# GCS project ID (optional if auto-detected from credentials)
GCS_PROJECT_ID=your-project-id

# File upload configuration
# Server-side uploads go through Cloud Run (~32 MiB request limit).
MAX_FILE_SIZE_BYTES=52428800
# Direct-to-GCS signed uploads bypass Cloud Run and can be larger.
MAX_SIGNED_UPLOAD_BYTES=1073741824
MAX_FILES=10
ALLOWED_MIME_TYPES=image/*,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.*,text/plain
UPLOAD_DIR=./uploads
UPLOAD_PREFIX=uploads
QUARANTINE_PREFIX=quarantine
# Set to false to skip magic-byte (content) validation.
STRICT_TYPE_CHECK=true

# API authentication: none | api-key
# api-key requires API_KEYS and protects every route except /health.
AUTH_MODE=none
# Comma-separated keys, supports rotation (any listed key is accepted).
API_KEYS=

# Comma-separated browser origins allowed to call the API (optional)
CORS_ORIGINS=

# Rate limiting (per instance, keyed by client IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=20

# Signed URL expiry (seconds)
SIGNED_URL_EXPIRES_SECONDS=900
