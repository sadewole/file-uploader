# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Google Cloud Storage configuration
# Use one of the following authentication methods:

# Method 1: Service account key file (JSON) - recommended for local development
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# Method 2: Service account key as base64 encoded string (useful for containers/CI)
# GOOGLE_APPLICATION_CREDENTIALS_BASE64=

# Method 3: Use Application Default Credentials (ADC) - for GCP environments

# GCS bucket name
GCS_BUCKET_NAME=your-bucket-name

# GCS project ID (optional if auto-detected from credentials)
GCS_PROJECT_ID=your-project-id

# File upload configuration
MAX_FILE_SIZE_BYTES=52428800 # 50 MB
ALLOWED_MIME_TYPES=image/*,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.*,text/plain
UPLOAD_DIR=./uploads # For temporary storage if needed
