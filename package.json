{
  "name": "gcp-file-upload-fastify",
  "version": "1.0.0",
  "description": "Fastify app with comprehensive configuration to upload files to Google Cloud Storage",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "fastify",
    "google-cloud-storage",
