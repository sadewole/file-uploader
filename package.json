    "@google-cloud/storage": "^8.4.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.7",
    "file-type": "^22.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10"
  },
  "type": "module"
